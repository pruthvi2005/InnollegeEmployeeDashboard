# ─── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
COMPANY_NAME="Jyohar Tech × Innollege"

# ─── Security ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-32-chars-minimum

# ─── Database ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=jyohar_db
MYSQL_USER=jyohar
MYSQL_PASSWORD=jyohar_pass_change_me
DATABASE_URL=mysql+pymysql://jyohar:jyohar_pass@localhost:3306/jyohar_db

# ─── Redis ───────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_pass_change_me
REDIS_URL=redis://:redis_pass@localhost:6379/0

# ─── MinIO (Object Storage) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123_change_me
MINIO_BUCKET=jyohar-files
MINIO_SECURE=false

# ─── Authentication ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OTP (SMS) ───────────────────────────────────────────────────────────────────
# Set true only for local development; set false to send through MSG91.
OTP_STUB_MODE=true

# MSG91 Flow API. Add these values to your local .env (never commit credentials).
# The approved template must contain the matching variable (default: VAR1).
# For India, register/approve the sender ID and DLT template with MSG91.
# OTP_STUB_MODE=false
# MSG91_API_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_OTP_VARIABLE=VAR1
# MSG91_COUNTRY_CODE=91

# ─── Email ───────────────────────────────────────────────────────────────────────
EMAIL_STUB_MODE=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@jyohartech.com

# ─── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# ─── Rate Limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─── Founder Seed Account ────────────────────────────────────────────────────────
FOUNDER_EMAIL=founder@jyohartech.com
FOUNDER_PASSWORD=Jyohar@2024
